{
  "v": 5,
  "id": "8a217986-dac1-44e8-8dcd-4fa96b25d908",
  "title": "경영환경 변화에 따른 조직진단",
  "canvas": {
    "w": 1280,
    "h": 905
  },
  "source": {
    "kind": "kg-html",
    "html": "<section class=\"kg-slide kg-root\" data-screen-label=\"경영환경 변화에 따른 조직진단\">\n\n  <header class=\"kg-header\">\n    <div class=\"kg-header__media\"></div>\n    <div class=\"kg-header__num kg-section-num\" data-kg-role=\"num\">03</div>\n    <div class=\"kg-header__divider\"></div>\n    <div class=\"kg-header__titles\">\n      <div class=\"kg-section-title\" data-kg-role=\"title\">연구수행방법론 — 경영환경 변화에 따른 조직진단</div>\n      <div class=\"kg-section-sub\" data-kg-role=\"subtitle\">기관위상 · 사업영역 · 기관역할 관점의 미래상 정립</div>\n    </div>\n    <div class=\"kg-chapter-tab\">\n      <span class=\"kg-chapter-tab__roman\">Ⅱ</span><span class=\"kg-chapter-tab__sep\"></span>\n      <span class=\"kg-chapter-tag\" data-kg-role=\"label\">사업수행계획</span>\n    </div>\n  </header>\n\n  <div class=\"kg-msgband\">\n    <p class=\"kg-message\" data-kg-role=\"message\">기관위상·사업영역·역할 관점의 미래상 정립을 선행하고 4대 관점을 토대로 경영목표–전략–전략과제 재정립</p>\n  </div>\n\n  <div class=\"kg-body-area\">\n    <div class=\"strow\">\n      <div class=\"kg-subtopic\" style=\"margin-bottom:0;border-bottom:none;\" data-kg-role=\"h2\">경영환경 변화에 따른 조직진단 방향성 도출</div>\n      <span class=\"kg-stamp\" data-kg-role=\"label\">Illustrative</span>\n    </div>\n\n    <div class=\"kg-content cols3\">\n\n      <!-- ============ 좌 ============ -->\n      <div class=\"kg-stackcol\">\n        <div class=\"kg-gbox kg-gbox--navy hdbox\" data-kg-role=\"h2\">기관만의 차별화된 미래상 정립을 통한<br>중장기 전략 수립</div>\n        <div class=\"gbar\" data-kg-role=\"h3\">주요추진방향</div>\n        <div class=\"dirs\">\n          <div class=\"dir\" data-kg-role=\"body2\">기관 미래상 설정을 통한 <b>미래성장동력(BHAG)</b> 독립성 확보</div>\n          <div class=\"dir\" data-kg-role=\"body2\">지속가능성 제고를 위한 <b>중장기 경영목표 재정립</b></div>\n          <div class=\"dir\" data-kg-role=\"body2\">중장기 경영목표 달성을 위한 <b>실행 메커니즘 구축</b></div>\n        </div>\n        <div class=\"gbar\" data-kg-role=\"h3\">사업환경 변화 분석 (3C)</div>\n        <div class=\"c3wrap\">\n          <div class=\"c3\">\n            <i class=\"ca\"><b>Customer</b><span data-kg-role=\"label\">고객·시장환경</span></i>\n            <i class=\"cb\"><b>Competition</b><span data-kg-role=\"label\">경쟁환경</span></i>\n            <i class=\"cc\"><b>Company</b><span data-kg-role=\"label\">내부역량</span></i>\n          </div>\n          <div class=\"fnote\" data-kg-role=\"caption\">BHAG, Big Hairy Audacious Goal</div>\n        </div>\n      </div>\n\n      <!-- ============ 중 ============ -->\n      <div class=\"kg-stackcol\">\n        <div class=\"ins\">\n          <div class=\"insc\">\n            <div class=\"insb\">\n              <div class=\"insk\" data-kg-role=\"body3\">정부정책, 경제사회환경 변화에 따른 業의 확장</div>\n              <div class=\"inst\" data-kg-role=\"body2\">대내·외 경영환경분석 및 전략적 방향 도출</div>\n            </div>\n            <div class=\"insl\" data-kg-role=\"h3\">기관 위상</div>\n          </div>\n          <span class=\"kg-plus\" data-kg-role=\"label\">+</span>\n          <div class=\"insc\">\n            <div class=\"insb\">\n              <div class=\"insk\" data-kg-role=\"body3\">선진사례 등 벤치마킹 분석</div>\n              <div class=\"inst\" data-kg-role=\"body2\">국내외 유사·선진기관 벤치마킹을 통한 시사점 발굴 및 사업영역 강화</div>\n            </div>\n            <div class=\"insl\" data-kg-role=\"h3\">사업영역</div>\n          </div>\n          <span class=\"kg-plus\" data-kg-role=\"label\">+</span>\n          <div class=\"insc\">\n            <div class=\"insb\">\n              <div class=\"insk\" data-kg-role=\"body3\">이해관계자 요구 분석</div>\n              <div class=\"inst\" data-kg-role=\"body2\">대·내외 이해관계자 및 고객에 대한 정의, 분류 등 체계화</div>\n            </div>\n            <div class=\"insl\" data-kg-role=\"h3\">기관 역할</div>\n          </div>\n        </div>\n\n        <div class=\"core\">\n          <div class=\"ccol\">\n            <div class=\"cch\" data-kg-role=\"h3\">Vision</div>\n            <div class=\"vlabel\" data-kg-role=\"h3\">경영목표–전략과제 연계</div>\n            <div class=\"ccb top\">\n              <svg class=\"temple\" viewBox=\"0 0 200 300\" preserveAspectRatio=\"xMidYMin meet\" role=\"img\" aria-label=\"경영목표·전략과제 연계 구조\">\n                <defs>\n                  <marker id=\"kg34-d\" markerWidth=\"7\" markerHeight=\"7\" refX=\"5\" refY=\"3\" orient=\"auto\">\n                    <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"var(--xg3)\"></path>\n                  </marker>\n                  <marker id=\"kg34-e\" markerWidth=\"8\" markerHeight=\"8\" refX=\"6\" refY=\"3.2\" orient=\"auto\">\n                    <path d=\"M0,0 L7,3.2 L0,6.4 Z\" fill=\"var(--ink-navy)\"></path>\n                  </marker>\n                </defs>\n\n                <!-- 라벨 아래에서 꺾여 지붕으로 내려가는 연결선 -->\n                <path d=\"M20,0 L20,9 L100,9 L100,15\" fill=\"none\" stroke=\"var(--ink-navy)\" stroke-width=\"1.3\" stroke-linejoin=\"round\" marker-end=\"url(#kg34-e)\"></path>\n\n                <!-- 지붕 — 납작한 사다리꼴 -->\n                <path d=\"M86,18 L114,18 L196,52 L4,52 Z\" fill=\"var(--neutral-200)\" stroke=\"var(--xg2)\" stroke-width=\"1\"></path>\n\n                <!-- 경영목표·전략과제 띠 -->\n                <rect x=\"8\" y=\"56\" width=\"184\" height=\"19\" fill=\"var(--navy-800)\"></rect>\n                <text data-slot=\"core\" x=\"100\" y=\"70\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#ffffff\">경영목표 · 전략과제</text>\n\n                <!-- 전략과제 3열 (붉은 점선) -->\n                <rect x=\"8\" y=\"80\" width=\"184\" height=\"76\" fill=\"var(--neutral-050)\" stroke=\"var(--red-500)\" stroke-width=\"1.4\" stroke-dasharray=\"5 3\"></rect>\n                <g fill=\"#ffffff\" stroke=\"var(--xg2)\" stroke-width=\"1\">\n                  <rect x=\"16\" y=\"86\" width=\"52\" height=\"64\"></rect>\n                  <rect x=\"74\" y=\"86\" width=\"52\" height=\"64\"></rect>\n                  <rect x=\"132\" y=\"86\" width=\"52\" height=\"64\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--ink-900)\">\n                  <text data-slot=\"a\" x=\"42\" y=\"105\">A</text>\n                  <text data-slot=\"b\" x=\"100\" y=\"105\">B</text>\n                  <text data-slot=\"c\" x=\"158\" y=\"105\">C</text>\n                </g>\n\n                <!-- 기단 4칸 -->\n                <g fill=\"var(--neutral-100)\" stroke=\"var(--xg2)\" stroke-width=\"1\">\n                  <rect x=\"8\" y=\"162\" width=\"43\" height=\"15\"></rect>\n                  <rect x=\"55\" y=\"162\" width=\"43\" height=\"15\"></rect>\n                  <rect x=\"102\" y=\"162\" width=\"43\" height=\"15\"></rect>\n                  <rect x=\"149\" y=\"162\" width=\"43\" height=\"15\"></rect>\n                </g>\n\n                <g stroke=\"var(--xg3)\" stroke-width=\"1.1\" stroke-dasharray=\"4 3\" marker-end=\"url(#kg34-d)\">\n                  <path d=\"M42,181 L42,198\"></path>\n                  <path d=\"M100,181 L100,198\"></path>\n                  <path d=\"M158,181 L158,198\"></path>\n                </g>\n\n                <g fill=\"#ffffff\" stroke=\"var(--xg2)\" stroke-width=\"1\">\n                  <rect x=\"16\" y=\"202\" width=\"52\" height=\"24\"></rect>\n                  <rect x=\"74\" y=\"202\" width=\"52\" height=\"24\"></rect>\n                  <rect x=\"132\" y=\"202\" width=\"52\" height=\"24\"></rect>\n                  <rect x=\"16\" y=\"230\" width=\"52\" height=\"24\"></rect>\n                  <rect x=\"74\" y=\"230\" width=\"52\" height=\"24\"></rect>\n                  <rect x=\"132\" y=\"230\" width=\"52\" height=\"24\"></rect>\n                  <rect x=\"16\" y=\"258\" width=\"52\" height=\"24\"></rect>\n                  <rect x=\"74\" y=\"258\" width=\"52\" height=\"24\"></rect>\n                  <rect x=\"132\" y=\"258\" width=\"52\" height=\"24\"></rect>\n                </g>\n              </svg>\n            </div>\n          </div>\n\n          <div class=\"ccol\">\n            <div class=\"cch\" data-kg-role=\"h3\">전략방향 4대 관점</div>\n            <div class=\"ccb\">\n              <div class=\"persp\">\n                <div class=\"pb\" data-kg-role=\"h3\">핵심사업</div>\n                <div class=\"pb\" data-kg-role=\"h3\">미래사업</div>\n                <div class=\"pb\" data-kg-role=\"h3\">고객관점</div>\n                <div class=\"pb\" data-kg-role=\"h3\">기관운영</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"ccol\">\n            <div class=\"cch blank\" aria-hidden=\"true\">지향점</div>\n            <div class=\"ccb\">\n              <div class=\"aim\">\n                <div class=\"ab\" data-kg-role=\"body2\">수혜 가치<br>확대</div>\n                <div class=\"ab\" data-kg-role=\"body2\">사업목적의<br>선명화</div>\n                <div class=\"ab\" data-kg-role=\"body2\">공적기능<br>지향점 제시</div>\n                <div class=\"ab\" data-kg-role=\"body2\">지속가능한<br>경영체질 강화</div>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"ccol\">\n            <div class=\"cch\" data-kg-role=\"h3\">경영목표(예시)</div>\n            <div class=\"ccb\">\n              <div class=\"goals\">\n                <div class=\"gr\"><span class=\"gb\" data-kg-role=\"label\">A</span>\n                  <span class=\"gt\" data-kg-role=\"body2\">수요예측 정확도(%), 안정적 기반 구축</span></div>\n                <div class=\"gr\"><span class=\"gb\" data-kg-role=\"label\">B</span>\n                  <span class=\"gt\" data-kg-role=\"body2\">시장 활성화, 친환경 중심체계 구축</span></div>\n                <div class=\"gr\"><span class=\"gb\" data-kg-role=\"label\">C</span>\n                  <span class=\"gt\" data-kg-role=\"body2\">사회적가치 기여도, 일자리 창출 건수 등</span></div>\n                <div class=\"gr\"><span class=\"gb\" data-kg-role=\"label\">D</span>\n                  <span class=\"gt\" data-kg-role=\"body2\">기관 고객만족도 결과, 종합청렴도, 경영평가 등급 등</span></div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      <!-- ============ 우 ============ -->\n      <div class=\"kg-stackcol\">\n        <div class=\"kg-card__bar kg-card__bar--navy rbar\" data-kg-role=\"h2\">주요 착안 사항</div>\n        <div class=\"rwrap\">\n          <div class=\"rlead\"><span class=\"rdot\"></span>\n            <span data-kg-role=\"body2\">전략적 실행력을 담보한 중장기 경영전략체계 수립</span></div>\n          <ul class=\"rol\">\n            <li data-kg-role=\"body2\">기관의 대내외 환경변화에 대한 대응력 강화를 위한 중장기 경영전략 수립</li>\n            <li data-kg-role=\"body2\">기관의 명확한 미래상 정립 및 경영목표 달성을 위한 실행체계 구축을 통한 실질적 역할 수행 방안 마련</li>\n          </ul>\n        </div>\n        <div class=\"rtaper\"></div>\n        <div class=\"flowdown\">\n          <div class=\"fd1\" data-kg-role=\"body2\">기관 미래상 도출</div>\n          <div class=\"kg-down\"></div>\n          <div class=\"fd1\" data-kg-role=\"body2\">중장기 경영전략 및 사업추진</div>\n          <div class=\"kg-down\"></div>\n          <div class=\"fd1 k\" data-kg-role=\"body2\">경영전략과 연계한<br>전략체계 로드맵 구축</div>\n        </div>\n      </div>\n\n    </div>\n  </div>\n\n  <footer class=\"kg-footer\">\n    <span class=\"kg-footer__src\" data-kg-role=\"caption\">자료: 기관 경영공시 · 국내외 유사기관 비교 · 내부 진단자료</span>\n    <span class=\"kg-footer__page\" data-kg-auto=\"page\" data-kg-role=\"caption\">34</span>\n    <span class=\"kg-footer__logo\"><img src=\"/kg/assets/keynes-group-logo.png\" alt=\"Keynes Group\"></span>\n  </footer>\n\n</section>",
    "css": ".cols3{grid-template-columns:258px 1fr 268px;gap:14px;}\n  .kg-stackcol{gap:7px;}\n  .strow{display:flex;align-items:center;justify-content:center;gap:14px;}\n\n  /* ---- 좌 ---- */\n  .hdbox{padding:10px 11px;border-radius:var(--r-sm);font-size:14px;font-weight:800;\n    line-height:1.35;text-align:center;color:#fff;flex:0 0 auto;}\n  .gbar{background:var(--neutral-200);color:var(--ink-navy);font-size:14px;font-weight:800;\n    text-align:center;padding:6px 8px;border-radius:var(--r-xs);flex:0 0 auto;}\n  .dirs{flex:0 0 auto;display:flex;flex-direction:column;gap:6px;}\n  .dir{background:#fff;border:1px solid var(--neutral-300);border-left:3px solid var(--navy-800);\n    border-radius:0 var(--r-xs) var(--r-xs) 0;padding:7px 9px;font-size:14px;line-height:1.35;color:var(--ink-900);}\n  .dir b{color:var(--navy-800);font-weight:700;}\n\n  .c3wrap{flex:1;min-height:0;display:flex;flex-direction:column;gap:4px;justify-content:center;\n    border:1px solid var(--neutral-300);border-radius:var(--r-xs);background:#fff;padding:7px;}\n  .c3{position:relative;flex:0 0 auto;height:176px;width:230px;margin:0 auto;}\n  .c3 i{position:absolute;width:122px;height:122px;border-radius:50%;border:1.5px solid;\n    display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;\n    font-style:normal;text-align:center;}\n  .c3 i b{font-size:13px;font-weight:800;letter-spacing:-.02em;line-height:1.1;}\n  .c3 i span{font-size:12px;color:var(--ink-700);font-weight:600;line-height:1.15;}\n  .c3 .ca{left:54px;top:0;background:rgba(31,73,125,.12);border-color:var(--navy-800);}\n  .c3 .ca b{color:var(--navy-800);}\n  .c3 .cb{left:0;top:54px;background:rgba(124,135,148,.12);border-color:var(--xg3);}\n  .c3 .cb b{color:var(--ink-navy);}\n  .c3 .cc{right:0;top:54px;background:rgba(79,129,189,.14);border-color:var(--blue-500);}\n  .c3 .cc b{color:var(--blue-600);}\n  .fnote{flex:0 0 auto;font-size:13px;color:var(--ink-500);}\n\n  /* ---- 중: 상단 3분석 ---- */\n  .ins{display:flex;align-items:stretch;gap:6px;flex:0 0 auto;}\n  .insc{flex:1;display:flex;flex-direction:column;gap:4px;}\n  .insb{flex:1;background:var(--neutral-100);border:1px solid var(--neutral-300);border-radius:var(--r-xs);\n    padding:8px 9px;display:flex;flex-direction:column;gap:4px;justify-content:center;text-align:center;}\n  .insk{font-size:14px;color:var(--ink-500);line-height:1.3;}\n  .inst{font-size:14px;font-weight:700;color:var(--ink-navy);line-height:1.35;}\n  .insl{text-align:center;font-size:14px;font-weight:800;font-style:italic;color:var(--ink-navy);\n    text-decoration:underline;text-underline-offset:3px;}\n  .ins .kg-plus{align-self:center;width:24px;height:24px;font-size:15px;}\n\n  /* ---- 중: 전략체계 ---- */\n  .core{flex:1;min-height:0;display:grid;grid-template-columns:1.45fr 0.85fr 0.9fr 1.5fr;gap:8px;}\n  .cch{font-size:14px;font-weight:800;font-style:italic;color:var(--ink-navy);text-align:center;\n    text-decoration:underline;text-underline-offset:3px;margin-bottom:5px;}\n  .ccol{display:flex;flex-direction:column;min-height:0;}\n  .ccb{flex:1;min-height:0;display:flex;flex-direction:column;gap:6px;justify-content:center;}\n  /* 도해는 라벨 바로 아래에 붙어야 연결선이 상자와 지붕을 잇는다 */\n  .ccb.top{justify-content:flex-start;}\n\n  /* 전략체계 도해 — 각도 있는 지붕과 점선 연결선이라 SVG (docs/SVG.md) */\n  .vlabel{background:#fff;border:1px solid var(--neutral-300);border-radius:var(--r-xs);\n    text-align:center;font-size:14px;font-weight:700;color:var(--ink-navy);padding:6px 8px;\n    line-height:1.25;flex:0 0 auto;margin-bottom:4px;}\n  .temple{width:100%;height:100%;display:block;}\n\n  /* 4대 관점 */\n  /* 칸을 가운데 띄우면 비어 보인다. 조각이 높이를 나눠 갖게 한다 */\n  .persp{display:flex;flex-direction:column;gap:6px;flex:1;}\n  .pb{flex:1;background:#fff;border:1px solid var(--neutral-300);border-radius:var(--r-xs);\n    display:flex;align-items:center;justify-content:center;text-align:center;\n    font-size:14px;font-weight:800;padding:6px 4px;line-height:1.2;}\n  /* 확대본에서는 네 칸이 모두 같은 모양이다 */\n  .cch.blank{visibility:hidden;}\n  .aim{display:flex;flex-direction:column;gap:6px;flex:1;}\n  .ab{flex:1;display:flex;align-items:center;justify-content:center;text-align:center;\n    font-size:14px;font-weight:700;font-style:italic;color:var(--blue-600);line-height:1.25;padding:4px 2px;}\n\n  /* 경영목표 예시 */\n  .goals{display:flex;flex-direction:column;gap:6px;flex:1;}\n  .gr{flex:1;display:flex;align-items:center;gap:7px;}\n  .gb{flex:0 0 auto;width:20px;height:20px;border-radius:var(--r-xs);background:var(--navy-800);\n    color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;}\n  /* 상자 없이 글자만. 다만 행 높이를 채우는 요소여야 검사가 빈 칸으로 보지 않는다 */\n  .gt{flex:1;align-self:stretch;display:flex;align-items:center;\n    padding:4px 2px;font-size:14px;line-height:1.3;color:var(--ink-900);}\n\n  /* ---- 우 ---- */\n  .rbar{border-radius:var(--r-xs);padding:7px 10px;font-size:15px;flex:0 0 auto;}\n  /* 한 상자로 묶고 안에서 고르게 벌린다. 조각마다 상자를 주면 칸이 헐거워 보인다 */\n  .rwrap{flex:1;min-height:0;display:flex;flex-direction:column;justify-content:space-evenly;gap:9px;\n    border:1px solid var(--neutral-300);border-radius:var(--r-xs);background:#fff;padding:11px 12px;}\n  .rlead{display:flex;gap:7px;align-items:flex-start;}\n  .rdot{flex:0 0 auto;width:7px;height:7px;border-radius:50%;background:var(--navy-800);margin-top:6px;}\n  .rlead span{font-size:14px;font-weight:800;color:var(--navy-800);line-height:1.35;}\n  .rol{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:11px;counter-reset:r;}\n  .rol li{position:relative;padding-left:20px;font-size:14px;line-height:1.45;\n    color:var(--ink-700);font-style:italic;counter-increment:r;}\n  .rol li::before{content:counter(r) \".\";position:absolute;left:0;top:0;font-weight:800;\n    color:var(--ink-navy);font-size:13px;font-style:normal;}\n  .rtaper{flex:0 0 auto;height:13px;background:var(--neutral-200);\n    clip-path:polygon(0 0,100% 0,78% 100%,22% 100%);}\n  .flowdown{flex:0 0 auto;display:flex;flex-direction:column;}\n  .flowdown .kg-down{height:15px;}\n  .fd1{background:linear-gradient(180deg,#EAF1FB,#D9E6F5);border:1px solid var(--blue-400);\n    border-radius:var(--r-xs);text-align:center;padding:8px 9px;font-size:14px;font-weight:700;\n    color:var(--navy-800);line-height:1.3;}\n  .fd1.k{background:linear-gradient(180deg,#2C5184,#17375E);border-color:#16365c;color:#fff;}",
