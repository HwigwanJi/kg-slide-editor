    "n.1.0": {
      "text": {
        "html": "<strong>사업별 성장기반과 수익구조가 구체화되어 유관기관 재구조화 방향에 따라 사업·경영체계의 역할 구분이 뚜렷해짐</strong>"
      }
    },
    "n.0.1": {
      "text": {
        "html": "02"
      }
    },
    "n.0.3.0": {
      "text": {
        "html": "핵심사업 및 이해관계자 진단"
      }
    },
    "n.0.3.1": {
      "text": {
        "html": "사업 재구조화 방안 검토"
      }
    },
