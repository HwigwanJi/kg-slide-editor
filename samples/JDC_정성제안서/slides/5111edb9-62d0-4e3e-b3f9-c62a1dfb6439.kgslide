{
  "v": 5,
  "id": "5111edb9-62d0-4e3e-b3f9-c62a1dfb6439",
  "title": "가치전략체계 고도화",
  "canvas": {
    "w": 1280,
    "h": 905
  },
  "source": {
    "kind": "kg-html",
    "html": "<section class=\"kg-slide kg-root\" data-screen-label=\"가치전략체계 고도화\">\n\n  <header class=\"kg-header\">\n    <div class=\"kg-header__media\"></div>\n    <div class=\"kg-header__num kg-section-num\" data-kg-role=\"num\">02</div>\n    <div class=\"kg-header__divider\"></div>\n    <div class=\"kg-header__titles\">\n      <div class=\"kg-section-title\" data-kg-role=\"title\">과업수행 주요내용 — 가치전략체계 고도화</div>\n      <div class=\"kg-section-sub\" data-kg-role=\"subtitle\">변화동인 도출부터 전략과제 도출까지 4단계 연계</div>\n    </div>\n    <div class=\"kg-chapter-tab\">\n      <span class=\"kg-chapter-tab__roman\">Ⅲ</span><span class=\"kg-chapter-tab__sep\"></span>\n      <span class=\"kg-chapter-tag\" data-kg-role=\"label\">분야별 과업수행 부문</span>\n    </div>\n  </header>\n\n  <div class=\"kg-msgband\">\n    <p class=\"kg-message\" data-kg-role=\"message\">기존 SWOT 분석의 문제점을 극복하는 프로세스를 구축하고 변화동인별 전략과제 연계성 제시</p>\n  </div>\n\n  <div class=\"kg-body-area\">\n    <div class=\"strow\">\n      <div class=\"kg-subtopic\" style=\"margin-bottom:0;border-bottom:none;\" data-kg-role=\"h2\">가치전략체계 수립</div>\n      <span class=\"kg-stamp\" data-kg-role=\"label\">Illustrative</span>\n    </div>\n\n    <div class=\"kg-content\" style=\"display:flex;flex-direction:column;\">\n      <div class=\"stage\">\n        <div class=\"quads\">\n\n          <!-- ===== ① DF 도출 ===== -->\n          <div class=\"qd\">\n            <div class=\"qdh\"><span class=\"qdn\" data-kg-role=\"label\">1</span>\n              <span class=\"qdt\" data-kg-role=\"h3\">내부역량 분석 및 외부환경 분석 시행<br>외부환경 분석을 통한 DF 도출</span></div>\n            <div class=\"qdb\">\n              <svg class=\"dia\" viewBox=\"0 0 580 210\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"내부역량·외부환경 분석을 통한 DF 도출\">\n                <defs>\n                  <marker id=\"q1a\" markerWidth=\"7\" markerHeight=\"7\" refX=\"5.5\" refY=\"3\" orient=\"auto\">\n                    <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"var(--blue-500)\"></path>\n                  </marker>\n                </defs>\n\n                <text data-slot=\"q1-lab-in\" x=\"24\" y=\"46\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"var(--ink-navy)\">내부</text>\n                <text data-slot=\"q1-lab-in2\" x=\"24\" y=\"64\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"var(--ink-navy)\">역량 분석</text>\n                <path d=\"M52,30 L52,80\" stroke=\"var(--xg3)\" stroke-width=\"1.2\"></path>\n\n                <g fill=\"#ffffff\" stroke=\"var(--xg2)\" stroke-width=\"1.2\">\n                  <rect x=\"64\" y=\"28\" width=\"104\" height=\"52\" rx=\"2\"></rect>\n                  <rect x=\"176\" y=\"28\" width=\"104\" height=\"52\" rx=\"2\"></rect>\n                  <rect x=\"288\" y=\"28\" width=\"104\" height=\"52\" rx=\"2\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"var(--ink-900)\">\n                  <text data-slot=\"q1-a1\" x=\"116\" y=\"59\">인프라</text>\n                  <text data-slot=\"q1-a2\" x=\"228\" y=\"59\">법적근거</text>\n                  <text data-slot=\"q1-a3\" x=\"340\" y=\"59\">사업</text>\n                </g>\n\n                <text data-slot=\"q1-lab-out\" x=\"24\" y=\"140\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"var(--ink-navy)\">외부</text>\n                <text data-slot=\"q1-lab-out2\" x=\"24\" y=\"158\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"var(--ink-navy)\">환경 분석</text>\n                <path d=\"M52,120 L52,172\" stroke=\"var(--xg3)\" stroke-width=\"1.2\"></path>\n\n                <g fill=\"#ffffff\" stroke=\"var(--xg2)\" stroke-width=\"1.2\">\n                  <rect x=\"64\" y=\"120\" width=\"76\" height=\"52\" rx=\"2\"></rect>\n                  <rect x=\"148\" y=\"120\" width=\"76\" height=\"52\" rx=\"2\"></rect>\n                  <rect x=\"232\" y=\"120\" width=\"76\" height=\"52\" rx=\"2\"></rect>\n                  <rect x=\"316\" y=\"120\" width=\"76\" height=\"52\" rx=\"2\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"var(--ink-900)\">\n                  <text data-slot=\"q1-b1\" x=\"102\" y=\"151\">정책</text>\n                  <text data-slot=\"q1-b2\" x=\"186\" y=\"151\">산업</text>\n                  <text data-slot=\"q1-b3\" x=\"270\" y=\"151\">사회</text>\n                  <text data-slot=\"q1-b4\" x=\"354\" y=\"151\">기술</text>\n                </g>\n\n                <g fill=\"none\" stroke=\"var(--blue-400)\" stroke-width=\"1.3\" marker-end=\"url(#q1a)\">\n                  <path d=\"M394,146 C428,146 424,60 452,60\"></path>\n                  <path d=\"M394,146 C428,146 428,104 452,104\"></path>\n                  <path d=\"M394,146 C428,146 430,166 452,166\"></path>\n                </g>\n\n                <g fill=\"var(--neutral-050)\" stroke=\"var(--navy-800)\" stroke-width=\"1\">\n                  <rect x=\"458\" y=\"44\" width=\"106\" height=\"32\" rx=\"2\"></rect>\n                  <rect x=\"458\" y=\"88\" width=\"106\" height=\"32\" rx=\"2\"></rect>\n                  <rect x=\"458\" y=\"150\" width=\"106\" height=\"32\" rx=\"2\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"15\" font-weight=\"800\" fill=\"var(--navy-800)\">\n                  <text data-slot=\"q1-df1\" x=\"511\" y=\"65\">DF 1</text>\n                  <text data-slot=\"q1-df2\" x=\"511\" y=\"109\">DF 2</text>\n                  <text data-slot=\"q1-dfn\" x=\"511\" y=\"171\">DF n</text>\n                </g>\n                <text x=\"511\" y=\"138\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"800\" fill=\"var(--ink-500)\">⋮</text>\n              </svg>\n            </div>\n          </div>\n\n          <!-- ===== ② Cross SWOT ===== -->\n          <div class=\"qd\">\n            <div class=\"qdh\"><span class=\"qdn\" data-kg-role=\"label\">2</span>\n              <span class=\"qdt\" data-kg-role=\"h3\">내부역량 분석을 통해 강점(S)과 약점(W)을, DF로부터 기회(O)와 위협(T)요인 도출하여 Cross SWOT 분석 시행</span></div>\n            <div class=\"qdb\">\n              <svg class=\"dia\" viewBox=\"0 0 580 190\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"SWOT 요인 도출과 Cross SWOT 분석\">\n                <g fill=\"var(--neutral-050)\" stroke=\"var(--navy-800)\" stroke-width=\"1\">\n                  <rect x=\"14\" y=\"8\" width=\"92\" height=\"36\" rx=\"2\"></rect>\n                  <rect x=\"14\" y=\"52\" width=\"92\" height=\"36\" rx=\"2\"></rect>\n                  <rect x=\"14\" y=\"96\" width=\"92\" height=\"36\" rx=\"2\"></rect>\n                  <rect x=\"14\" y=\"140\" width=\"92\" height=\"36\" rx=\"2\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"16\" font-weight=\"800\" fill=\"var(--navy-800)\">\n                  <text data-slot=\"q2-s\" x=\"60\" y=\"32\">S</text>\n                  <text data-slot=\"q2-w\" x=\"60\" y=\"76\">W</text>\n                  <text data-slot=\"q2-o\" x=\"60\" y=\"120\">O</text>\n                  <text data-slot=\"q2-t\" x=\"60\" y=\"164\">T</text>\n                </g>\n\n                <g fill=\"#ffffff\" stroke=\"var(--xg2)\" stroke-width=\"1.2\">\n                  <rect x=\"150\" y=\"20\" width=\"98\" height=\"148\" rx=\"2\"></rect>\n                  <rect x=\"256\" y=\"20\" width=\"98\" height=\"148\" rx=\"2\"></rect>\n                  <rect x=\"362\" y=\"20\" width=\"98\" height=\"148\" rx=\"2\"></rect>\n                  <rect x=\"468\" y=\"20\" width=\"98\" height=\"148\" rx=\"2\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-weight=\"800\" fill=\"var(--navy-800)\">\n                  <text data-slot=\"q2-so\" x=\"199\" y=\"87\" font-size=\"15\">SO</text>\n                  <text data-slot=\"q2-so2\" x=\"199\" y=\"108\" font-size=\"15\" font-weight=\"600\" fill=\"var(--ink-700)\">역량확대</text>\n                  <text data-slot=\"q2-wo\" x=\"305\" y=\"87\" font-size=\"15\">WO</text>\n                  <text data-slot=\"q2-wo2\" x=\"305\" y=\"108\" font-size=\"15\" font-weight=\"600\" fill=\"var(--ink-700)\">기회포착</text>\n                  <text data-slot=\"q2-st\" x=\"411\" y=\"87\" font-size=\"15\">ST</text>\n                  <text data-slot=\"q2-st2\" x=\"411\" y=\"108\" font-size=\"15\" font-weight=\"600\" fill=\"var(--ink-700)\">선택집중</text>\n                  <text data-slot=\"q2-wt\" x=\"517\" y=\"87\" font-size=\"15\">WT</text>\n                  <text data-slot=\"q2-wt2\" x=\"517\" y=\"108\" font-size=\"15\" font-weight=\"600\" fill=\"var(--ink-700)\">약점보완</text>\n                </g>\n              </svg>\n            </div>\n          </div>\n\n          <!-- ===== ③ 중요도 판단 ===== -->\n          <div class=\"qd\">\n            <div class=\"qdh\"><span class=\"qdn\" data-kg-role=\"label\">3</span>\n              <span class=\"qdt\" data-kg-role=\"h3\">S, W, O, T 기반의 비전달성을 위한 경영목표 및<br>전사 핵심지표 설정</span></div>\n            <div class=\"qdb\">\n              <svg class=\"dia\" viewBox=\"0 0 580 200\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"중요도 판단과 경영목표·성과지표 설정\">\n                <defs>\n                  <marker id=\"q3a\" markerWidth=\"7\" markerHeight=\"7\" refX=\"5.5\" refY=\"3\" orient=\"auto\">\n                    <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"var(--blue-500)\"></path>\n                  </marker>\n                </defs>\n\n                <!-- 판단 기준 — 외부(O·T) / 내부(S·W) -->\n                <g fill=\"var(--neutral-100)\" stroke=\"var(--xg2)\" stroke-width=\"1.2\">\n                  <rect x=\"14\" y=\"6\" width=\"54\" height=\"26\" rx=\"13\"></rect>\n                  <rect x=\"78\" y=\"6\" width=\"54\" height=\"26\" rx=\"13\"></rect>\n                  <rect x=\"200\" y=\"6\" width=\"54\" height=\"26\" rx=\"13\"></rect>\n                  <rect x=\"264\" y=\"6\" width=\"54\" height=\"26\" rx=\"13\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--ink-navy)\">\n                  <text data-slot=\"q3-o\" x=\"41\" y=\"25\">O</text>\n                  <text data-slot=\"q3-t\" x=\"105\" y=\"25\">T</text>\n                  <text data-slot=\"q3-s\" x=\"227\" y=\"25\">S</text>\n                  <text data-slot=\"q3-w\" x=\"291\" y=\"25\">W</text>\n                </g>\n\n                <g fill=\"var(--blue-100)\" stroke=\"var(--blue-300)\" stroke-width=\"1.2\">\n                  <rect x=\"14\" y=\"46\" width=\"118\" height=\"44\" rx=\"4\"></rect>\n                  <rect x=\"14\" y=\"100\" width=\"118\" height=\"44\" rx=\"4\"></rect>\n                  <rect x=\"200\" y=\"46\" width=\"118\" height=\"44\" rx=\"4\"></rect>\n                  <rect x=\"200\" y=\"100\" width=\"118\" height=\"44\" rx=\"4\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"var(--ink-navy)\">\n                  <text data-slot=\"q3-l1\" x=\"73\" y=\"73\">기관의 영향도</text>\n                  <text data-slot=\"q3-l2\" x=\"73\" y=\"127\">비전연계성</text>\n                  <text data-slot=\"q3-r1\" x=\"259\" y=\"73\">적용가능성</text>\n                  <text data-slot=\"q3-r2\" x=\"259\" y=\"127\">개선가능성</text>\n                </g>\n\n                <!-- 네 기준이 가운데로 모인다 -->\n                <g stroke=\"var(--xg2)\" stroke-width=\"1.2\">\n                  <path d=\"M132,68 L140,68\"></path><path d=\"M132,122 L140,122\"></path>\n                  <path d=\"M192,68 L200,68\"></path><path d=\"M192,122 L200,122\"></path>\n                </g>\n\n                <rect x=\"140\" y=\"46\" width=\"52\" height=\"98\" rx=\"4\" fill=\"#ffffff\" stroke=\"var(--navy-800)\" stroke-width=\"1.4\"></rect>\n                <text data-slot=\"q3-mid\" x=\"166\" y=\"90\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--navy-800)\">중요도</text>\n                <text data-slot=\"q3-mid2\" x=\"166\" y=\"110\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--navy-800)\">판단</text>\n\n                <!-- 판단 결과가 아래를 돌아 경영목표로 -->\n                <path d=\"M166,144 L166,182 L392,182 L392,166\" fill=\"none\" stroke=\"var(--blue-500)\" stroke-width=\"1.4\" marker-end=\"url(#q3a)\"></path>\n\n                <g fill=\"var(--blue-100)\" stroke=\"var(--blue-400)\" stroke-width=\"1.2\">\n                  <rect x=\"340\" y=\"8\" width=\"104\" height=\"34\" rx=\"5\"></rect>\n                  <rect x=\"340\" y=\"52\" width=\"104\" height=\"34\" rx=\"5\"></rect>\n                  <rect x=\"340\" y=\"96\" width=\"104\" height=\"34\" rx=\"5\"></rect>\n                  <rect x=\"340\" y=\"140\" width=\"104\" height=\"34\" rx=\"5\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--navy-800)\">\n                  <text data-slot=\"q3-g1\" x=\"392\" y=\"30\">경영목표</text>\n                  <text data-slot=\"q3-g2\" x=\"392\" y=\"74\">경영목표</text>\n                  <text data-slot=\"q3-g3\" x=\"392\" y=\"118\">경영목표</text>\n                  <text data-slot=\"q3-g4\" x=\"392\" y=\"162\">경영목표</text>\n                </g>\n\n                <g stroke=\"var(--xg2)\" stroke-width=\"1.2\">\n                  <path d=\"M444,25 L474,25\"></path><path d=\"M444,69 L474,69\"></path>\n                  <path d=\"M444,113 L474,113\"></path><path d=\"M444,157 L474,157\"></path>\n                </g>\n                <g fill=\"#ffffff\" stroke=\"var(--xg2)\" stroke-width=\"1.2\">\n                  <rect x=\"474\" y=\"8\" width=\"94\" height=\"34\" rx=\"5\"></rect>\n                  <rect x=\"474\" y=\"52\" width=\"94\" height=\"34\" rx=\"5\"></rect>\n                  <rect x=\"474\" y=\"96\" width=\"94\" height=\"34\" rx=\"5\"></rect>\n                  <rect x=\"474\" y=\"140\" width=\"94\" height=\"34\" rx=\"5\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"var(--ink-900)\">\n                  <text data-slot=\"q3-k1\" x=\"521\" y=\"30\">성과지표</text>\n                  <text data-slot=\"q3-k2\" x=\"521\" y=\"74\">성과지표</text>\n                  <text data-slot=\"q3-k3\" x=\"521\" y=\"118\">성과지표</text>\n                  <text data-slot=\"q3-k4\" x=\"521\" y=\"162\">성과지표</text>\n                </g>\n              </svg>\n            </div>\n          </div>\n\n          <!-- ===== ④ CSF · 전략과제 ===== -->\n          <div class=\"qd\">\n            <div class=\"qdh\"><span class=\"qdn\" data-kg-role=\"label\">4</span>\n              <span class=\"qdt\" data-kg-role=\"h3\">Cross SWOT을 통해 경영목표 달성을 위한 CSF 도출 및<br>Clustering을 통한 전략과제 도출</span></div>\n            <div class=\"qdb\">\n              <svg class=\"dia\" viewBox=\"0 0 580 200\" preserveAspectRatio=\"xMidYMid meet\" role=\"img\" aria-label=\"CSF 도출과 전략과제 클러스터링\">\n                <defs>\n                  <marker id=\"q4a\" markerWidth=\"7\" markerHeight=\"7\" refX=\"5.5\" refY=\"3\" orient=\"auto\">\n                    <path d=\"M0,0 L6,3 L0,6 Z\" fill=\"var(--blue-500)\"></path>\n                  </marker>\n                </defs>\n\n                <g fill=\"#ffffff\" stroke=\"var(--xg2)\" stroke-width=\"1.2\">\n                  <rect x=\"14\" y=\"14\" width=\"130\" height=\"34\" rx=\"2\"></rect>\n                  <rect x=\"14\" y=\"58\" width=\"130\" height=\"34\" rx=\"2\"></rect>\n                  <rect x=\"14\" y=\"102\" width=\"130\" height=\"34\" rx=\"2\"></rect>\n                  <rect x=\"14\" y=\"146\" width=\"130\" height=\"34\" rx=\"2\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"15\" font-weight=\"800\" fill=\"var(--navy-800)\">\n                  <text data-slot=\"q4-so\" x=\"79\" y=\"36\">SO</text>\n                  <text data-slot=\"q4-wo\" x=\"79\" y=\"80\">WO</text>\n                  <text data-slot=\"q4-st\" x=\"79\" y=\"124\">ST</text>\n                  <text data-slot=\"q4-wt\" x=\"79\" y=\"168\">WT</text>\n                </g>\n\n                <g fill=\"var(--neutral-050)\" stroke=\"var(--xg2)\" stroke-width=\"1.2\">\n                  <rect x=\"196\" y=\"8\" width=\"130\" height=\"30\" rx=\"2\"></rect>\n                  <rect x=\"196\" y=\"46\" width=\"130\" height=\"30\" rx=\"2\"></rect>\n                  <rect x=\"196\" y=\"84\" width=\"130\" height=\"30\" rx=\"2\"></rect>\n                  <rect x=\"196\" y=\"122\" width=\"130\" height=\"30\" rx=\"2\"></rect>\n                  <rect x=\"196\" y=\"160\" width=\"130\" height=\"30\" rx=\"2\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"var(--ink-navy)\">\n                  <text data-slot=\"q4-c1\" x=\"261\" y=\"28\">CSF</text>\n                  <text data-slot=\"q4-c2\" x=\"261\" y=\"66\">CSF</text>\n                  <text data-slot=\"q4-c3\" x=\"261\" y=\"104\">CSF</text>\n                  <text data-slot=\"q4-c4\" x=\"261\" y=\"142\">CSF</text>\n                  <text data-slot=\"q4-c5\" x=\"261\" y=\"180\">CSF</text>\n                </g>\n\n                <g fill=\"none\" stroke=\"var(--blue-400)\" stroke-width=\"1.3\" marker-end=\"url(#q4a)\">\n                  <path d=\"M326,23 C356,23 356,36 384,36\"></path>\n                  <path d=\"M326,99 C356,99 356,92 384,92\"></path>\n                  <path d=\"M326,175 C356,175 356,148 384,148\"></path>\n                </g>\n\n                <g fill=\"var(--blue-100)\" stroke=\"var(--blue-400)\" stroke-width=\"1\">\n                  <rect x=\"390\" y=\"20\" width=\"132\" height=\"34\" rx=\"2\"></rect>\n                  <rect x=\"390\" y=\"76\" width=\"132\" height=\"34\" rx=\"2\"></rect>\n                  <rect x=\"390\" y=\"132\" width=\"132\" height=\"34\" rx=\"2\"></rect>\n                </g>\n                <g text-anchor=\"middle\" font-size=\"14\" font-weight=\"800\" fill=\"var(--navy-800)\">\n                  <text data-slot=\"q4-t1\" x=\"456\" y=\"42\">전략과제</text>\n                  <text data-slot=\"q4-t2\" x=\"456\" y=\"98\">전략과제</text>\n                  <text data-slot=\"q4-t3\" x=\"456\" y=\"154\">전략과제</text>\n                </g>\n                <text x=\"456\" y=\"188\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"800\" fill=\"var(--ink-500)\">⋮</text>\n              </svg>\n            </div>\n          </div>\n\n        </div>\n\n        <!-- 사분면을 잇는 큰 화살표 -->\n        <svg class=\"lk lk1\" viewBox=\"0 0 70 84\" aria-hidden=\"true\">\n          <path d=\"M0,26 L44,26 L44,8 L70,42 L44,76 L44,58 L0,58 Z\" fill=\"var(--neutral-300)\"></path>\n        </svg>\n        <svg class=\"lk lk2\" viewBox=\"0 0 84 64\" aria-hidden=\"true\">\n          <path d=\"M26,0 L58,0 L58,36 L76,36 L42,64 L8,36 L26,36 Z\" fill=\"var(--neutral-300)\"></path>\n        </svg>\n        <svg class=\"lk lk3\" viewBox=\"0 0 84 64\" aria-hidden=\"true\">\n          <path d=\"M26,0 L58,0 L58,36 L76,36 L42,64 L8,36 L26,36 Z\" fill=\"var(--neutral-300)\"></path>\n        </svg>\n      </div>\n    </div>\n  </div>\n\n  <footer class=\"kg-footer\">\n    <span class=\"kg-footer__src\" data-kg-role=\"caption\">자료: 내부역량 진단 · 외부환경 분석 · 전략체계 수립 방법론</span>\n    <span class=\"kg-footer__page\" data-kg-auto=\"page\" data-kg-role=\"caption\">37</span>\n    <span class=\"kg-footer__logo\"><img src=\"/kg/assets/keynes-group-logo.png\" alt=\"Keynes Group\"></span>\n  </footer>\n\n</section>",
    "css": ".strow{display:flex;align-items:center;justify-content:center;gap:14px;}\n  .stage{position:relative;flex:1;min-height:0;}\n  .quads{position:absolute;inset:0;display:grid;grid-template-columns:1fr 1fr;\n    grid-template-rows:1fr 1fr;gap:12px;}\n  .qd{position:relative;display:flex;flex-direction:column;min-height:0;\n    border:1px solid var(--neutral-300);border-radius:var(--r-xs);\n    background:repeating-linear-gradient(135deg,rgba(96,106,122,.07) 0 1px,transparent 1px 5px),#fff;}\n  .qdh{flex:0 0 auto;display:flex;align-items:flex-start;gap:8px;padding:8px 10px 4px;}\n  .qdn{flex:0 0 auto;width:19px;height:19px;border-radius:var(--r-xs);background:var(--xg3);\n    color:#fff;font-size:12px;font-weight:800;display:flex;align-items:center;justify-content:center;}\n  .qdt{flex:1;font-size:14px;font-weight:700;color:var(--ink-navy);line-height:1.3;text-align:center;}\n  .qdb{flex:1;min-height:0;padding:2px 8px 8px;}\n  .dia{width:100%;height:100%;display:block;}\n  /* 사분면을 잇는 큰 화살표 — 하나로 덮으면 빈 칸으로 잡히므로 자리마다 따로 둔다 */\n  .lk{position:absolute;pointer-events:none;display:block;}\n  .lk1{left:50%;margin-left:-35px;top:128px;width:70px;height:84px;}\n  .lk2{left:75%;margin-left:-42px;top:50%;margin-top:-54px;width:84px;height:60px;}\n  .lk3{left:25%;margin-left:-42px;top:50%;margin-top:-54px;width:84px;height:60px;}",
